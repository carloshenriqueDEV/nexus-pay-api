        </mxCell>
        <mxCell id="QvFDJiKfUQ6ZBvjTQtZ8-15" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Decisões de arquitetura&lt;/h1&gt;&lt;p&gt;O Fluxo será divido em duas etapas uma sincrona e outra asincrona, para evitar atrasos na resposta da api.&lt;/p&gt;&lt;p&gt;A partir da entrada no Middleare até a inserção na fila será feita de forma sincrona, a leitura da fila até o registro no ropositório será assincrono.&lt;/p&gt;&lt;p&gt;Para implementar a fila optei por utilizar o Channels do .net, pois pela a natureza da operação, telemetria, que é secundária não a risco para o negócio caso ocorra perda de dados. Com Channels se tem um solução nativa e altamente perfomática em memória para a solução do problema&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="850" x="-750" y="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
