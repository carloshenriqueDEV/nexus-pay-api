        <mxCell id="QvFDJiKfUQ6ZBvjTQtZ8-13" parent="QvFDJiKfUQ6ZBvjTQtZ8-14" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;" value="Contratos" vertex="1">
